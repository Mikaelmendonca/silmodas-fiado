# Copie para .env e ajuste. Nada aqui é obrigatório, exceto o tópico para receber no celular.

# Tópico do ntfy (o "canal" que o celular assina). Escolha algo longo e impossível de adivinhar,
# porque quem souber o nome consegue LER os alertas (que trazem nomes e valores).
# Ex.: silmodas-k29x8f3q-alertas
FIADO_NTFY_TOPIC=

# Servidor ntfy (padrão: o público, gratuito)
# FIADO_NTFY_SERVER=https://ntfy.sh

# Hora do envio diário e com quantos dias de antecedência avisar (além do dia do vencimento)
FIADO_ALERT_TIME=08:00
FIADO_WARN_DAYS=3,1

# Senha do painel. OBRIGATÓRIA para abrir o painel no celular (rede). O instalador
# (scripts/instalar-mac.sh) gera uma automaticamente.
FIADO_PASSWORD=

# Onde ficam os backups diários (mantém os últimos 30 dias)
# FIADO_BACKUP_DIR=backups

# Fuso da loja e arquivo do banco
FIADO_TZ=America/Sao_Paulo
# FIADO_DB=fiado.db
